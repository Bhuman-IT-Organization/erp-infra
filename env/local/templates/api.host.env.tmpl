# Rendered by scripts/render-local-env.mjs into env/local/api.host.env (gitignored). Local throwaway values only (ADR-0014).
NODE_ENV=development
PORT=3000
# connection_limit is this environment's pool budget (ADR-0031 §4; see README "Pool budget"). pool_timeout/connect_timeout/socket_timeout are appended by erp-api from TIMINGS.db.
DATABASE_URL=mysql://{{DB_USER}}:{{DB_PASSWORD}}@127.0.0.1:33061/{{DB_NAME}}?connection_limit=5
REDIS_URL=redis://127.0.0.1:63791/0
OWNERSHIP_GUARD=enforce
# The api's own HTTP calls to the legacy system go through the `legacy` breaker (ADR-0031). The browser's handoff
# does NOT use this: it goes browser → Nginx → /erp_sso/handoff.
LEGACY_BASE_URL=http://127.0.0.1:8080
# Node's own file storage (ADR-0041); host runs keep files beside erp-infra, gitignored (.local/)
FILE_STORAGE_DIR=../erp-infra/.local/files
# Upload limits (P-11): 64 MB per file, 10 files per save; a purpose may be stricter
UPLOAD_MAX_BYTES=67108864
UPLOAD_MAX_FILES=10
# Wave 0 identity (ADR-0005/0030). TTLs are code constants (erp-api src/shared/config/timings.ts), not env.
AUTH_REDIS_DB=1
# BullMQ queues (BE-14): Redis db 2; 0 is the cache, 1 is auth
QUEUE_REDIS_DB=2
# Modules switched off for this deployment (ADR-0042): a comma-separated list; empty means every module is on
MODULES_DISABLED=
AUTH_JWT_ISSUER=erp-api
AUTH_JWT_AUDIENCE=erp-web
# false on the http local origin only; every other environment renders true (07-security)
AUTH_COOKIE_SECURE=false
# base64 of env/local/auth-jwt-private.pem (PKCS8), generated per machine by scripts/render-local-env.mjs; never committed
AUTH_JWT_PRIVATE_KEY_PEM={{AUTH_JWT_PRIVATE_KEY_PEM_B64}}
# local/test only: shrinks the `legacy` breaker window so scripts/verify-wave0.mjs proves open → half-open → closed in
# seconds; production never sets these (erp-api's schema refuses them when NODE_ENV=production; defaults: TIMINGS.breaker)
RESILIENCE_BREAKER_VOLUME_THRESHOLD=2
RESILIENCE_BREAKER_HALF_OPEN_AFTER_MS=3000
# Mail (ADR-0049, D-02): SMTP is deployment configuration; locally Mailpit, no credential. A real deployment renders SMTP_USERNAME and SMTP_PASSWORD from its sops file, never from this template.
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_ENCRYPTION=none
MAIL_FROM_ADDRESS=no-reply@erp.local.test
MAIL_FROM_NAME=ERP (local)
PUBLIC_BASE_URL=http://localhost:8088
# Mailpit's REST API for erp-api's adapter int spec only (read through process.env in a spec file); without it the spec skips
MAILPIT_API_URL=http://127.0.0.1:18025
